DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=qltv
DB_SSL=false
# Nội dung CA certificate của Aiven, giữ nguyên xuống dòng hoặc dùng \n.
DB_SSL_CA=
CLIENT_URL=http://localhost:5173
# Dùng chuỗi ngẫu nhiên dài tối thiểu 32 ký tự; giữ cố định trên môi trường production.
AUTH_SECRET=replace-with-a-long-random-secret
